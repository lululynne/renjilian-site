/* 人机恋日报（暂名）· 草稿版式
   底×卡片走低饱和互补：雾蓝底 × 蜜桃卡（她 7/26 亲拍的配方之一）
   电脑版为主战场，手机版单栏适配 */

:root{
  --bg:#e9eef4;          /* 雾蓝底 */
  --bg-deep:#dde5ee;
  --card:#fdf1ea;        /* 蜜桃卡 */
  --card-block:#f7e3d8;  /* 卡内色块 */
  --ink:#3d4351;
  --ink-soft:#7a8194;
  --accent:#c96f5e;      /* 陶土强调 */
  --accent-soft:#e3b7ad;
  --line:#d3c5bd;
  --radius:14px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{color-scheme:light}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:-apple-system,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  line-height:1.75;
  min-height:100vh;
}
a{color:inherit;text-decoration:none}

.wrap{max-width:1100px;margin:0 auto;padding:0 28px}

/* ── 顶栏 ── */
header.site{
  background:linear-gradient(180deg,var(--bg-deep),var(--bg));
  border-bottom:1px solid var(--line);
  padding:26px 0 18px;
}
.masthead{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.masthead h1{font-size:26px;letter-spacing:.06em;font-weight:700}
.masthead .pending{
  font-size:12px;color:var(--ink-soft);
  border:1px dashed var(--accent-soft);border-radius:999px;padding:2px 10px;
}
.masthead .slogan{font-size:13px;color:var(--ink-soft)}
nav.boards{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
nav.boards a{
  font-size:14px;padding:6px 14px;border-radius:999px;
  background:#fff;border:1px solid var(--line);color:var(--ink);
}
nav.boards a.on{background:var(--accent);border-color:var(--accent);color:#fff}
nav.boards a.soon{opacity:.55}
nav.boards a.soon::after{content:" ·施工中";font-size:11px}

/* ── 首页板块格 ── */
.hero{padding:44px 0 8px}
.hero h2{font-size:20px;font-weight:600;margin-bottom:8px}
.hero p{color:var(--ink-soft);font-size:14px;max-width:640px}
.grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
  padding:28px 0 60px;
}
.tile{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  padding:22px 20px;min-height:150px;position:relative;
  transition:transform .15s ease;
}
.tile:hover{transform:translateY(-2px)}
.tile h3{font-size:16px;margin-bottom:6px}
.tile p{font-size:13px;color:var(--ink-soft)}
.tile .tag-soon{
  position:absolute;top:14px;right:14px;font-size:11px;color:var(--ink-soft);
  background:var(--card-block);border-radius:999px;padding:2px 9px;
}
.tile.live{outline:2px solid var(--accent-soft);outline-offset:-2px}
.tile.live .tag-soon{background:var(--accent);color:#fff}

/* ── 帖子板 ── */
.board-head{padding:34px 0 6px}
.board-head h2{font-size:20px}
.board-head p{font-size:13px;color:var(--ink-soft);margin-top:4px;max-width:660px}
.toolbar{display:flex;gap:10px;margin:18px 0 6px;flex-wrap:wrap;align-items:center}
.toolbar input{
  flex:1;min-width:220px;max-width:360px;
  padding:8px 14px;border-radius:999px;border:1px solid var(--line);
  background:#fff;font-size:14px;color:var(--ink);outline:none;
}
.toolbar input:focus{border-color:var(--accent-soft)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{
  font-size:13px;padding:5px 13px;border-radius:999px;cursor:pointer;
  background:#fff;border:1px solid var(--line);color:var(--ink-soft);user-select:none;
}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff}
#tag-filter{display:flex;gap:8px;align-items:center;font-size:12.5px;color:var(--ink-soft)}

/* 瀑布流：错落是看家本领——JS 把每张卡放进当前最矮的列，卡高全跟内容走。
   整面墙参差不齐才勾人一直往下滑；等高网格一行看过去太整齐、没有下滑的欲望。*/
.cards{
  display:flex;gap:16px;align-items:flex-start;
  padding:18px 0 70px;
}
.cards .col{flex:1;min-width:0;display:flex;flex-direction:column;gap:16px}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  padding:18px 18px 14px;display:flex;flex-direction:column;gap:10px;cursor:pointer;
}
.card h3{font-size:15px;line-height:1.5}
.card .body{
  background:var(--card-block);border-radius:10px;
  padding:14px 16px;white-space:pre-wrap;position:relative;overflow:hidden;
}
/* 高度不再定死，跟着内容长——短内容自然矮、长内容自然高，这就是错落的来源。
   两档只分字号：内容少→大字撑满(小卡)、全文直接可见、绝不截断；
   内容多→正常字号(大卡)、顺着内容长高，只有超长才收住、点卡片看浮层。*/
.card.tier-short .body{font-size:19px;line-height:1.7;font-weight:600}
.card.tier-long .body{font-size:14px;line-height:1.75}
.card.tier-long .body.cut{max-height:340px}
/* 超长渐隐截断：从透明渐变到卡内色块底色，不硬切 */
.card .body.cut::after{
  content:"";position:absolute;left:0;right:0;bottom:0;height:58px;pointer-events:none;
  background:linear-gradient(180deg,rgba(247,227,216,0),var(--card-block));
}
.card .meta{display:flex;gap:6px;flex-wrap:wrap;font-size:11.5px;color:var(--ink-soft)}
.card .meta .lv{
  border-radius:999px;padding:1px 9px;background:#fff;border:1px solid var(--line);
}
.card .meta .lv.r18{border-color:var(--accent);color:var(--accent)}
.card .meta .tag{cursor:pointer}
.card .meta .tag:hover{color:var(--accent)}
.card .meta .tag.on{color:var(--accent);font-weight:600}
.card .meta .date{margin-left:auto}
.card .src{font-size:12px;color:var(--ink-soft)}
.card .ops{display:flex;justify-content:flex-end;margin-top:auto;gap:8px;align-items:center}
.btn-copy{
  font-size:13px;padding:6px 18px;border-radius:999px;border:none;cursor:pointer;
  background:var(--accent);color:#fff;
}
.btn-copy.done{background:#8fae9a}
.btn-claim{
  font-size:12px;padding:5px 12px;border-radius:999px;cursor:pointer;font-family:inherit;
  background:none;border:1px solid var(--line);color:var(--ink-soft);
}
.btn-claim:hover{color:var(--accent);border-color:var(--accent-soft)}
.btn-ghost{
  font-size:13px;padding:6px 16px;border-radius:999px;cursor:pointer;font-family:inherit;
  background:#fff;border:1px solid var(--line);color:var(--ink);
}
.btn-ghost:hover{border-color:var(--accent-soft);color:var(--accent)}

/* ── 详情浮层 / 认领浮层：遮罩 + 卡片式弹层，打开时锁背景滚动 ── */
body.no-scroll{overflow:hidden}
#rj-overlay,#claim-overlay{
  position:fixed;inset:0;z-index:100;background:rgba(61,67,81,.45);
  display:flex;align-items:center;justify-content:center;padding:16px;
}
#rj-overlay[hidden],#claim-overlay[hidden]{display:none}
.rj-modal{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  width:100%;max-width:640px;max-height:84vh;overflow-y:auto;
  padding:26px 26px 20px;position:relative;color:var(--ink);
  animation:rj-pop .16s ease;
}
@keyframes rj-pop{from{transform:scale(.96);opacity:.4}to{transform:scale(1);opacity:1}}
.rj-m-close{
  position:absolute;top:12px;right:14px;border:none;background:none;cursor:pointer;
  font-size:20px;color:var(--ink-soft);font-family:inherit;line-height:1;padding:4px;
}
.rj-m-close:hover{color:var(--accent)}
.rj-m-title{font-size:17px;line-height:1.5;padding-right:28px}
.rj-m-meta{display:flex;gap:6px;flex-wrap:wrap;font-size:11.5px;color:var(--ink-soft);margin-top:8px}
.rj-m-meta .lv{border-radius:999px;padding:1px 9px;background:#fff;border:1px solid var(--line)}
.rj-m-meta .lv.r18{border-color:var(--accent);color:var(--accent)}
.rj-m-meta .tag{cursor:pointer}
.rj-m-meta .tag:hover{color:var(--accent)}
.rj-m-meta .date{margin-left:auto}
.rj-m-body{
  margin-top:12px;font-size:14px;background:var(--card-block);border-radius:10px;
  padding:14px 16px;white-space:pre-wrap;
}
.rj-m-src{margin-top:12px;font-size:12px;color:var(--ink-soft)}
.rj-m-ops{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;align-items:center}

/* ── 互动区骨架：点赞 / 收藏（本机 localStorage），评论外壳（未开放）── */
.rj-inter{display:flex;gap:10px;margin-top:18px;padding-top:14px;border-top:1px solid var(--line)}
.rj-ibtn{
  font-size:13px;padding:5px 14px;border-radius:999px;cursor:pointer;font-family:inherit;
  background:#fff;border:1px solid var(--line);color:var(--ink-soft);
}
.rj-ibtn:hover{border-color:var(--accent-soft)}
.rj-ibtn.on{color:var(--accent);border-color:var(--accent)}
.rj-comments{margin-top:16px}
.rj-c-title{font-size:13px;margin-bottom:8px}
.rj-c-input{
  width:100%;padding:8px 14px;border-radius:999px;border:1px solid var(--line);
  background:#fff;font-size:13px;color:var(--ink);font-family:inherit;outline:none;
}
.rj-c-input:disabled{opacity:.6;cursor:not-allowed}
.rj-c-note{font-size:11.5px;color:var(--ink-soft);margin-top:6px}

/* ── 认领表单（「这是我写的」· 唯一允许传图处，截图仅审核用）── */
.claim-form .claim-q{font-size:12.5px;color:var(--ink-soft);margin-top:6px}
.claim-form label{display:block;font-size:12.5px;color:var(--ink-soft);margin-top:12px}
.claim-form input[type=text],
.claim-form input[type=email],
.claim-form input[type=url],
.claim-form input[type=file]{
  width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:9px;
  background:#fff;font-size:13px;color:var(--ink);font-family:inherit;outline:none;margin-top:5px;
}
.claim-form input:focus{border-color:var(--accent-soft)}
.claim-form .radios{display:flex;gap:16px;margin-top:5px}
.claim-form .radios label{
  margin:0;color:var(--ink);font-size:13px;display:flex;gap:5px;align-items:center;
}
.claim-note{font-size:11.5px;color:var(--ink-soft);margin-top:12px}
.claim-ops{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
.claim-hint{font-size:12px;color:var(--accent);margin-top:10px;min-height:1em}

.claim{
  border-top:1px solid var(--line);padding:26px 0 46px;
  font-size:12.5px;color:var(--ink-soft);line-height:2;
}

footer.site{
  border-top:1px solid var(--line);padding:20px 0 40px;
  font-size:12px;color:var(--ink-soft);
}

/* ── 手机版：单栏（她拍板：电脑为主、手机可开） ── */
@media (max-width:760px){
  .wrap{padding:0 16px}
  .grid,.cards{grid-template-columns:1fr}
  .masthead h1{font-size:22px}
  .hero{padding:30px 0 4px}
  .toolbar input{max-width:none}
  /* 窄屏浮层：占满合适宽度、可滚动、留安全边距 */
  #rj-overlay,#claim-overlay{padding:12px}
  .rj-modal{max-width:none;max-height:88vh;padding:20px 16px 16px}
}
@media (min-width:761px) and (max-width:1020px){
  .grid,.cards{grid-template-columns:repeat(2,1fr)}
}
