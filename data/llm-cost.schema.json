{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二人称 · 大模型成本 · 订阅表",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "fx_updated_at",
    "disclaimer",
    "items"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "fx_updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "disclaimer": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "vendor",
          "product",
          "prices",
          "global_avg",
          "sparkline",
          "status",
          "last_verified"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "verified",
              "stale"
            ]
          },
          "sparkline": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "global_avg": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "method"
            ],
            "properties": {
              "method": {
                "const": "multi_region_mean"
              }
            }
          }
        }
      }
    }
  }
}
