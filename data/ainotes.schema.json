{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二人称 · 小纸条词条契约",
  "description": "公开词条必须verified；v1保留原15字段，v2可混合旧条与完整31字段v3。草稿仅本机preview读取，不进公开数据。",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/legacy_entry"
          },
          {
            "$ref": "#/$defs/v3_entry"
          }
        ]
      }
    }
  },
  "$defs": {
    "legacy_entry": {
      "type": "object",
      "required": [
        "id",
        "zh",
        "en",
        "brief",
        "line",
        "sources",
        "added_at",
        "last_verified",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^bk-[a-z0-9-]+$"
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "简洁版：一眼扫过的短注，给已经懂一点的人"
        },
        "line": {
          "type": "string",
          "minLength": 40,
          "maxLength": 200,
          "description": "详细版：1 到 3 个完整句子，新手不用追问就能读懂"
        },
        "more": {
          "type": "string"
        },
        "for_us": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bk-[a-z0-9-]+$"
          }
        },
        "seen_in": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^kr-[a-z0-9-]+$"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "added_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "const": "verified"
        }
      }
    },
    "v3_entry": {
      "type": "object",
      "required": [
        "id",
        "zh",
        "en",
        "aliases",
        "tags",
        "brief",
        "line",
        "more",
        "for_us",
        "related",
        "seen_in",
        "sources",
        "added_at",
        "last_verified",
        "status",
        "for_whom",
        "helps_with",
        "device",
        "difficulty",
        "region",
        "edge",
        "owner",
        "what",
        "where_used",
        "access",
        "timeline",
        "reception",
        "use_tags",
        "company",
        "lifecycle",
        "nianlun_seen"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^bk-[a-z0-9-]+$"
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "description": "v3简洁版：按七问说明；不等同旧版短注"
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "description": "v3一句解释；完整条件在七问和详细资料"
        },
        "more": {
          "type": "string"
        },
        "for_us": {
          "type": "string",
          "minLength": 1
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bk-[a-z0-9-]+$"
          }
        },
        "seen_in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "added_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "const": "verified"
        },
        "for_whom": {
          "type": "string",
          "minLength": 1
        },
        "helps_with": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "edge": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "what": {
          "type": "string",
          "minLength": 1
        },
        "where_used": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "timeline": {
          "type": "string",
          "minLength": 1
        },
        "reception": {
          "type": "string",
          "minLength": 1
        },
        "use_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "设计与绘图",
              "视频",
              "音乐与语音",
              "写作与文案",
              "编程与做应用",
              "办公与文档",
              "学习与搜索",
              "电商与营销",
              "AI 助手与模型",
              "云服务与开发平台",
              "硬件与芯片",
              "网络安全",
              "企业与政府",
              "底层技术（给开发者）",
              "公司"
            ]
          }
        },
        "company": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "full_name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "business": {
              "type": "string"
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "在用",
                "已通知弃用",
                "已停用",
                "已下架",
                "已退役",
                "不适用",
                "待核"
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "required": [
                "name",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          }
        },
        "nianlun_seen": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {
          "const": 1
        },
        "items": {
          "items": {
            "$ref": "#/$defs/legacy_entry"
          }
        }
      }
    },
    {
      "properties": {
        "schema_version": {
          "const": 2
        }
      }
    }
  ]
}
