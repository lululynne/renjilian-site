{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二人称 · 小纸条词条契约",
  "description": "刊读精读卡的页下注词条。公开文件只放 status=verified 的条目；草稿只留本机 data/ainotes.drafts.json，不进仓库。",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "zh",
          "en",
          "line",
          "sources",
          "added_at",
          "last_verified",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^bk-[a-z0-9-]+$"
          },
          "zh": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "more": {
            "type": "string"
          },
          "for_us": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^bk-[a-z0-9-]+$"
            }
          },
          "seen_in": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^kr-[a-z0-9-]+$"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          },
          "added_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "verified",
              "draft"
            ]
          }
        }
      }
    }
  }
}
