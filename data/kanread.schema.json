{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二人称 · 刊读数据契约",
  "description": "外链精读卡。站内只保留标题、作者、日期、原文链接、本站摘要与旁白；不整篇转载。",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source_name",
          "source_url",
          "published_at",
          "last_verified",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^kr-[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "title_original": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "published_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "verified",
              "draft",
              "unavailable"
            ]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          },
          "hook": {
            "type": "string",
            "maxLength": 60
          },
          "human_voice": {
            "type": "string",
            "maxLength": 900
          },
          "machine_voice": {
            "type": "string",
            "maxLength": 900
          },
          "machine_byline": {
            "type": "string"
          },
          "credits": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "role",
                "who"
              ],
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "maxLength": 12
                },
                "who": {
                  "type": "string",
                  "maxLength": 24
                }
              }
            }
          },
          "roundtable": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "who",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "who": {
                  "type": "string",
                  "maxLength": 24
                },
                "text": {
                  "type": "string",
                  "maxLength": 500,
                  "description": "来访模型自己的话，逐字取自一手记录。上限 2026-09-19 从 220 放到 500：把客人的话削到 220 字，正好坐实它说的那句话筒还在谁手里。空行分段，页面按段渲染"
                },
                "context": {
                  "type": "string",
                  "maxLength": 60,
                  "description": "这段话是在什么条件下说的（例如读完原文之后、被问的是哪一句），渲染成名字后面一小行灰字"
                },
                "disclosure": {
                  "type": "string",
                  "maxLength": 80,
                  "description": "该模型的厂商若在原文中被点名，必须写明"
                }
              }
            }
          }
        }
      }
    }
  }
}
